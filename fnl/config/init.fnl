(set vim.g.mapleader " ")
(set vim.g.maplocalleader " ")
(set vim.g.loaded_netrwPlugin 1)

(set vim.o.autoindent true)
(set vim.o.colorcolumn :120)
(set vim.o.cursorline true)
(set vim.o.expandtab true)
(set vim.o.hlsearch true)
(set vim.o.ignorecase true)
(set vim.o.number true)
(set vim.o.relativenumber true)
(set vim.o.scrolloff 8)
(set vim.o.shiftwidth 2)
(set vim.o.signcolumn :yes)
(set vim.o.smartcase true)
(set vim.o.smartindent true)
(set vim.o.softtabstop 2)
(set vim.o.swapfile true)
(set vim.o.tabstop 2)
(set vim.o.termguicolors true)
(set vim.o.title true)
(set vim.o.undofile true)
(set vim.o.updatetime 250)
(set vim.o.wrap false)
(set vim.o.clipboard :unnamedplus)
(set vim.o.completeopt "menuone,noselect,popup")
(set vim.o.guicursor "n-v-c:block-Cursor/lCursor,i-ci:ver25-Cursor/lCursor")

(require :config.packages)
((. (require :vim._core.ui2) :enable) {})
(require :config.theme)
(require :config.plugins)
(require :config.format)
(require :config.review)
(require :config.keymaps)
(require :config.lsp)
